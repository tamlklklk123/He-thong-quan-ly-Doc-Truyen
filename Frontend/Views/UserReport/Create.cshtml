@{ ViewData["Title"] = "Báo lỗi hệ thống"; }
<div class="container" style="max-width:720px;padding:3rem 1rem"><div class="glass-card" style="padding:2rem"><h2>🚩 Báo lỗi hệ thống</h2><p>Hãy mô tả lỗi bạn gặp. Báo cáo sẽ được chuyển vào mục Báo cáo vi phạm của Admin và bạn sẽ nhận thông báo kết quả.</p>
@if(TempData["SuccessMessage"]!=null){<p style="color:#34d399">@TempData["SuccessMessage"]</p>}
@if(TempData["InfoMessage"]!=null){<p>@TempData["InfoMessage"]</p>}
<div asp-validation-summary="All" style="color:#f87171"></div>
<form method="post" action="/UserReport/Create">@Html.AntiForgeryToken()<label>Loại lỗi</label><select name="reason" class="form-control" required><option value="">Chọn loại lỗi</option><option value="Lỗi đọc truyện">Lỗi đọc truyện</option><option value="Lỗi nạp Xu / VIP">Lỗi nạp Xu / VIP</option><option value="Lỗi tài khoản">Lỗi tài khoản</option><option value="Lỗi hiển thị">Lỗi hiển thị</option><option value="Lỗi khác">Lỗi khác</option></select><label style="display:block;margin-top:1rem">Mô tả chi tiết</label><textarea class="form-control" name="details" required maxlength="2000" rows="5" placeholder="Các bước gây lỗi, thông báo lỗi, thiết bị..."></textarea><label style="display:block;margin-top:1rem">Đường dẫn trang gặp lỗi (không bắt buộc)</label><input class="form-control" type="url" name="pageUrl" maxlength="300" placeholder="https://..."/><button type="submit" class="btn btn-primary" style="margin-top:1rem">Gửi báo lỗi</button></form></div></div>