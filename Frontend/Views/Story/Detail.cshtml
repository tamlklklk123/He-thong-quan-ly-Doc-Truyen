                    <div style="width: 52px; height: 52px; border-radius: 50%; overflow: hidden; border: 2px solid #8b5cf6;">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=120&auto=format&fit=crop&q=80" alt="Author" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                    <div>
                        <h4 style="font-size: 1.05rem; font-weight: 800; color: #fff;">@Model.AuthorName</h4>
                        <div style="font-size: 0.8rem; color: #a78bfa;">Tác giả Bạch Kim MêTruyệnPlus</div>
