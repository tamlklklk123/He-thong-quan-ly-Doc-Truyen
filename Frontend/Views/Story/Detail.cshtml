                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; border-radius: var(--radius-md); background: rgba(148, 163, 184, 0.06); border: 1px solid rgba(148, 163, 184, 0.2);">
                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <span style="font-weight: 800; color: #94a3b8; font-size: 0.85rem;">🥈 2</span>
                            <span style="font-size: 0.85rem; font-weight: 700; color: #fff;">VôSongĐộcGiả</span>
                        </div>
                        <span style="font-size: 0.8rem; font-weight: 700; color: #38bdf8;">3,850 Hoa</span>
                    </div>

                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; border-radius: var(--radius-md); background: rgba(217, 119, 6, 0.06); border: 1px solid rgba(217, 119, 6, 0.2);">
                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <span style="font-weight: 800; color: #d97706; font-size: 0.85rem;">🥉 3</span>
                            <span style="font-size: 0.85rem; font-weight: 700; color: #fff;">BạchYKiếmKhách</span>
                        </div>
                        <span style="font-size: 0.8rem; font-weight: 700; color: #a78bfa;">2,100 Hoa</span>
