                <button type="button" class="btn btn-secondary btn-sm" style="width: 100%; border-radius: var(--radius-full); font-weight: 700;" onclick="alert('Đã theo dõi tác giả @Model.AuthorName thành công!');">
                    + Theo dõi tác giả (48.5K Fans)
                </button>
            </div>

            <!-- Widget 2: Top Bảng Đóng Góp / Fan Cứng -->
            <div class="glass-card" style="padding: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                    <h3 style="font-size: 0.95rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.4rem;">
                        🏆 Top Fan Cứng Đóng Góp
                    </h3>
                    <span style="font-size: 0.75rem; color: #fbbf24;">TUẦN</span>
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.65rem;">
                    <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.5rem 0.75rem; border-radius: var(--radius-md); background: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25);">
                        <div style="display: flex; align-items: center; gap: 0.6rem;">
                            <span style="font-weight: 800; color: #fbbf24; font-size: 0.85rem;">🥇 1</span>
                            <span style="font-size: 0.85rem; font-weight: 700; color: #fff;">KhaThiênĐạo</span>
                        </div>
                        <span style="font-size: 0.8rem; font-weight: 700; color: #fbbf24;">5,200 Hoa</span>
