<style>
    .rating-choice input { position:absolute; opacity:0; width:1px; height:1px; }
    .rating-choice span { display:inline-block; border:1px solid var(--border-color); padding:0.6rem 0.9rem; border-radius:0.65rem; color:#cbd5e1; }
    .rating-choice input:checked + span { background:rgba(245,158,11,0.18); border-color:#fbbf24; color:#fbbf24; font-weight:800; }
    .rating-choice input:focus-visible + span { outline:2px solid #fbbf24; outline-offset:2px; }
</style>
<script>
    function showDetailTab(tabId, btn) {
        document.getElementById('tabChapters').style.display = 'none';
        document.getElementById('tabComments').style.display = 'none';
        document.getElementById('tabRatings').style.display = 'none';
        document.getElementById(tabId).style.display = 'block';

        var buttons = btn.parentElement.querySelectorAll('button');
        buttons.forEach(function(b) {
            b.classList.remove('btn-primary');
            b.classList.add('btn-secondary');
        });
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-primary');
    }

    function filterChapters(q) {
        var items = document.querySelectorAll('.chapter-item');
        q = q.toLowerCase().trim();
        items.forEach(function(item) {
            var text = item.innerText.toLowerCase();
            if (text.includes(q)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    // Sau khi gửi đánh giá sẽ trở về đúng tab đánh giá.
    document.addEventListener('DOMContentLoaded', function() {
        if (window.location.hash === '#tabRatings') {
            const button = document.getElementById('ratingTabButton');
            if (button) showDetailTab('tabRatings', button);
        }
    });

    // SignalR Realtime Room & Live Comments for Story Detail
    document.addEventListener("DOMContentLoaded", function() {
        const checkConn = setInterval(function() {
            if (window.realtimeConnection && window.realtimeConnection.state === "Connected") {
                clearInterval(checkConn);

                // Join room for this story
                window.realtimeConnection.invoke("JoinStoryRoom", "@Model.Id").catch(e => console.warn(e));

                window.realtimeConnection.on("UpdateActiveReaders", function(count) {
                    const el = document.getElementById("liveActiveReadersCount");
                    if (el) el.innerText = count;
                });

                window.realtimeConnection.on("ReceiveComment", function(cm) {
                    const container = document.getElementById("commentsListContainer");
                    if (!container) return;

                    const emptyNotice = document.getElementById("emptyCommentsNotice");
                    if (emptyNotice) emptyNotice.remove();

                    const item = document.createElement("div");
                    item.className = "glass-card";
                    item.style.padding = "1.25rem";
                    item.style.border = "1px solid rgba(139, 92, 246, 0.6)";
                    item.style.boxShadow = "0 0 25px rgba(139, 92, 246, 0.35)";
                    item.style.animation = "slideInRight 0.4s ease-out";
                    item.innerHTML = `
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.6rem;">
                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <div style="width: 36px; height: 36px; border-radius: 50%; overflow: hidden; border: 1px solid #8b5cf6;">
                                    <img src="${cm.userAvatar}" alt="${cm.userName}" style="width: 100%; height: 100%; object-fit: cover;" />
                                </div>
                                <div>
                                    <div style="font-size: 0.9rem; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 0.5rem;">
                                        ${cm.userName}
                                        <span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-size: 0.65rem; border: 1px solid #10b981;">REALTIME ⚡</span>
                                    </div>
                                    <div style="font-size: 0.75rem; color: var(--text-dim);">${cm.createdAt}</div>
                                </div>
                            </div>
                            <span class="badge badge-primary" style="font-size: 0.65rem;">ĐỘC GIẢ</span>
                        </div>
                        <p style="font-size: 0.9rem; color: #e2e8f0; line-height: 1.6;">${cm.content}</p>
                    `;
                    container.insertBefore(item, container.firstChild);
                });
            }
        }, 300);

        window.addEventListener("beforeunload", function() {
            if (window.realtimeConnection && window.realtimeConnection.state === "Connected") {
                window.realtimeConnection.invoke("LeaveStoryRoom", "@Model.Id").catch(e => {});
            }
        });
    });
</script>
